		"sideBarTitle.foreground": "#eeebe7",
		"sideBarSectionHeader.background": "#1b1a18",
		"sideBarSectionHeader.foreground": "#eeebe7",
		"sideBarSectionHeader.border": "#393633",
		"panel.background": "#1b1a18",
		"panel.border": "#393633",
		"panelTitle.activeForeground": "#eeebe7",
		"panelTitle.inactiveForeground": "#aba59d",
		"panelTitle.activeBorder": "#ff7a66",
		"statusBar.background": "#1b1a18",
		"statusBar.foreground": "#dedad5",
		"statusBar.border": "#393633",
		"statusBar.debuggingBackground": "#cbbfb2",
