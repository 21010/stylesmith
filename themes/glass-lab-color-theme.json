		"gitDecoration.deletedResourceForeground": "#ff9a6b",
		"gitDecoration.untrackedResourceForeground": "#82d6a6",
		"gitDecoration.ignoredResourceForeground": "#9a948c",
		"gitDecoration.conflictingResourceForeground": "#f0c46c",
		"terminal.background": "#1b1a18",
		"terminal.foreground": "#dedad5",
		"terminalCursor.foreground": "#ff7a66",
		"terminal.selectionBackground": "#5c403a80",
		"terminal.ansiBlack": "#393633",
		"terminal.ansiRed": "#ff7a66",
		"terminal.ansiGreen": "#92d6a6",
		"terminal.ansiYellow": "#f0c46c",
		"terminal.ansiBlue": "#9ec4e4",
		"terminal.ansiMagenta": "#ff93cc",
		"terminal.ansiCyan": "#90d4cf",
		"terminal.ansiWhite": "#d0cac3",
		"terminal.ansiBrightBlack": "#aba49c",
		"terminal.ansiBrightRed": "#ffa294",
		"terminal.ansiBrightGreen": "#b3e3c1",
		"terminal.ansiBrightYellow": "#f5d797",
		"terminal.ansiBrightBlue": "#bfd8ee",
