			"italic": true
		},
		"variable.readonly": "#d6b48c",
		"keyword": "#ff8a77",
		"string": "#c8bf9c",
		"number": "#d6b48c",
		"regexp": "#c6bfa2",
		"namespace": "#c2b8ac",
