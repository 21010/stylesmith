	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#aba49c",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control"
			],
			"settings": {
				"foreground": "#ff8a77"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#aea79f"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#ede9e4"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#c6bfa2"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#d6b48c"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#c2b8ac"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#dedad5"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#d4cdc5"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#dedad5",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#c6bfa2"
			}
		},
		{
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#ff8a77"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#c2b8ac"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#ff8a77",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#c6bfa2"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#ff7a66"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#82d6a6"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#ff9a6b"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff6fb0"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#ede9e4",
		"method": "#ede9e4",
		"class": "#c2b8ac",
		"interface": "#c2b8ac",
		"type": "#c2b8ac",
		"enumMember": "#d6b48c",
		"property": "#d4cdc5",
		"parameter": {
			"foreground": "#dedad5",
			"italic": true
		},
		"variable.readonly": "#d6b48c",
		"keyword": "#ff8a77",
		"string": "#c6bfa2",
		"number": "#d6b48c",
		"regexp": "#c6bfa2"
	}
}
