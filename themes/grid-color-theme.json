		"titleBar.activeForeground": "#c8dde3",
		"titleBar.inactiveBackground": "#040506",
		"titleBar.inactiveForeground": "#8aa3ab",
		"titleBar.border": "#1d2a30",
		"activityBar.background": "#040506",
		"activityBar.foreground": "#e2f1f5",
