		"sideBarSectionHeader.background": "#040506",
		"sideBarSectionHeader.foreground": "#e2f1f5",
		"sideBarSectionHeader.border": "#1d2a30",
		"panel.background": "#040506",
		"panel.border": "#1d2a30",
		"panelTitle.activeForeground": "#e2f1f5",
		"panelTitle.inactiveForeground": "#8aa3ab",
		"panelTitle.activeBorder": "#2fd8ea",
		"statusBar.background": "#040506",
		"statusBar.foreground": "#c8dde3",
		"statusBar.border": "#1d2a30",
		"statusBar.debuggingBackground": "#ff8a2a",
		"statusBar.debuggingForeground": "#040506",
		"statusBar.noFolderBackground": "#040506",
		"statusBarItem.remoteBackground": "#2fd8ea",
		"statusBarItem.remoteForeground": "#040506",
		"breadcrumb.foreground": "#8aa3ab",
		"breadcrumb.focusForeground": "#e2f1f5",
		"breadcrumb.activeSelectionForeground": "#2fd8ea",
		"list.activeSelectionBackground": "#0f1316",
		"list.activeSelectionForeground": "#e2f1f5",
		"list.inactiveSelectionBackground": "#0d1013",
		"list.inactiveSelectionForeground": "#c8dde3",
		"list.hoverBackground": "#0d1013",
		"list.focusOutline": "#2fd8ea",
		"list.highlightForeground": "#2fd8ea",
		"list.errorForeground": "#ff6b6b",
		"list.warningForeground": "#ffcf73",
		"input.background": "#0d1013",
		"input.foreground": "#c8dde3",
		"input.border": "#1d2a30",
		"input.placeholderForeground": "#6f8a93",
		"inputOption.activeBorder": "#2fd8ea",
		"dropdown.background": "#0d1013",
		"dropdown.foreground": "#c8dde3",
		"dropdown.border": "#1d2a30",
		"button.background": "#2fd8ea",
		"button.foreground": "#040506",
		"button.hoverBackground": "#ff8a2a",
		"button.secondaryBackground": "#0d1013",
		"button.secondaryForeground": "#c8dde3",
		"badge.background": "#ff8a2a",
		"badge.foreground": "#040506",
		"progressBar.background": "#2fd8ea",
		"quickInput.background": "#0d1013",
		"quickInput.foreground": "#c8dde3",
		"menu.background": "#0d1013",
		"menu.foreground": "#c8dde3",
		"menu.selectionBackground": "#0f1316",
		"menu.selectionForeground": "#e2f1f5",
		"notifications.background": "#0d1013",
		"notifications.foreground": "#c8dde3",
		"notifications.border": "#1d2a30",
		"gitDecoration.addedResourceForeground": "#7fd6a3",
		"gitDecoration.modifiedResourceForeground": "#a9a6f2",
		"gitDecoration.deletedResourceForeground": "#ff8a5c",
		"gitDecoration.untrackedResourceForeground": "#7fd6a3",
		"gitDecoration.ignoredResourceForeground": "#6f8a93",
		"gitDecoration.conflictingResourceForeground": "#ffcf73",
		"terminal.background": "#040506",
		"terminal.foreground": "#c8dde3",
		"terminalCursor.foreground": "#2fd8ea",
		"terminal.selectionBackground": "#1f4a5480",
		"terminal.ansiBlack": "#1d2a30",
		"terminal.ansiRed": "#f07a72",
		"terminal.ansiGreen": "#8fdca8",
		"terminal.ansiYellow": "#f2c36b",
		"terminal.ansiBlue": "#8fb8de",
		"terminal.ansiMagenta": "#c9a6ec",
		"terminal.ansiCyan": "#7ccfd6",
		"terminal.ansiWhite": "#c8dde3",
		"terminal.ansiBrightBlack": "#768d96",
		"terminal.ansiBrightRed": "#f7a7a3",
		"terminal.ansiBrightGreen": "#b6eac6",
		"terminal.ansiBrightYellow": "#f6d696",
		"terminal.ansiBrightBlue": "#b3cfe9",
		"terminal.ansiBrightMagenta": "#dcc2f2",
		"terminal.ansiBrightCyan": "#a2dde2",
		"terminal.ansiBrightWhite": "#e2f1f5"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#768d96",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": {
				"foreground": "#3ee0f0"
			}
		},
		{
			"scope": ["keyword.control.flow", "keyword.control.trycatch"],
			"settings": {
				"foreground": "#ff9a3c"
			}
		},
		{
			"scope": ["keyword.control"],
			"settings": {
				"foreground": "#3ee0f0"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#88a0a8"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#e2f1f5"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#8fd6e0"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#b8eef4"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#7fc8d4"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#c8dde3"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#b6cdd3"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#c8dde3",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#a0e8f0"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#3ee0f0"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#8fd6e0"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#3ee0f0",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#8fd6e0"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#2fd8ea"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff6b6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#e2f1f5",
		"method": "#e2f1f5",
		"class": "#7fc8d4",
		"interface": "#7fc8d4",
		"type": "#7fc8d4",
		"enumMember": "#b8eef4",
		"property": "#b6cdd3",
		"parameter": {
			"foreground": "#c8dde3",
			"italic": true
		},
		"variable.readonly": "#b8eef4",
		"keyword": "#3ee0f0",
		"string": "#8fd6e0",
		"number": "#b8eef4",
		"regexp": "#a0e8f0"
	}
}
