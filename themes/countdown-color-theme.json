		"panelTitle.activeBorder": "#ff6a5c",
		"statusBar.background": "#0c0e0f",
		"statusBar.foreground": "#c9cdd0",
		"statusBar.border": "#2a2d31",
		"statusBar.debuggingBackground": "#86c2cc",
		"statusBar.debuggingForeground": "#0c0e0f",
