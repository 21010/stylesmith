		"quickInput.foreground": "#c9cdd0",
		"menu.background": "#17191c",
		"menu.foreground": "#c9cdd0",
		"menu.selectionBackground": "#1a1c1f",
		"menu.selectionForeground": "#e3e6e8",
		"notifications.background": "#17191c",
		"notifications.foreground": "#c9cdd0",
		"notifications.border": "#2a2d31",
