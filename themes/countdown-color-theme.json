				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff9ab8"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#e6e8ef",
		"method": "#e6e8ef",
		"class": "#8fd3dd",
		"interface": "#8fd3dd",
		"type": "#8fd3dd",
		"enumMember": "#ff6a5c",
		"property": "#a9c0e0",
		"parameter": {
			"foreground": "#cfd3de",
			"italic": true
		},
		"variable.readonly": "#ff6a5c",
		"keyword": "#e8c27a",
		"string": "#c9bfd9",
		"number": "#ff6a5c",
		"regexp": "#d8c9a6",
		"namespace": "#8fd3dd",
		"enum": "#8fd3dd",
		"struct": "#8fd3dd",
		"typeParameter": "#8fd3dd",
		"decorator": "#e6e8ef",
		"macro": "#e6e8ef",
		"selfKeyword": "#e8c27a",
		"*.deprecated": {
			"strikethrough": true
		}
	}
}
