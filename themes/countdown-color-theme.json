	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#8d9297",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type", "keyword.control"],
			"settings": {
				"foreground": "#86c2cc"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#9fa4a9"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#e0e3e5"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#c4bfb7"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#ff6a5c"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#a3c9cf"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#c9cdd0"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#bfc4c8"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#c9cdd0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#d0cbc2"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#86c2cc"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#c4bfb7"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#86c2cc",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#c4bfb7"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#ff6a5c"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff9ab8"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#e0e3e5",
		"method": "#e0e3e5",
		"class": "#a3c9cf",
		"interface": "#a3c9cf",
		"type": "#a3c9cf",
		"enumMember": "#ff6a5c",
		"property": "#bfc4c8",
		"parameter": {
			"foreground": "#c9cdd0",
			"italic": true
		},
		"variable.readonly": "#ff6a5c",
		"keyword": "#86c2cc",
		"string": "#c4bfb7",
		"number": "#ff6a5c",
		"regexp": "#d0cbc2"
	}
}
