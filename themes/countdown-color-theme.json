		"list.inactiveSelectionBackground": "#17191c",
		"list.inactiveSelectionForeground": "#c9cdd0",
		"list.hoverBackground": "#17191c",
		"list.focusOutline": "#ff6a5c",
		"list.highlightForeground": "#ff6a5c",
		"list.errorForeground": "#ff9ab8",
		"list.warningForeground": "#ffcf73",
		"input.background": "#17191c",
		"input.foreground": "#c9cdd0",
		"input.border": "#2a2d31",
		"input.placeholderForeground": "#878c92",
		"inputOption.activeBorder": "#ff6a5c",
		"dropdown.background": "#17191c",
		"dropdown.foreground": "#c9cdd0",
		"dropdown.border": "#2a2d31",
