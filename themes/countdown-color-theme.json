		"button.foreground": "#0c0e0f",
		"button.hoverBackground": "#86c2cc",
		"button.secondaryBackground": "#17191c",
		"button.secondaryForeground": "#c9cdd0",
		"badge.background": "#86c2cc",
		"badge.foreground": "#0c0e0f",
