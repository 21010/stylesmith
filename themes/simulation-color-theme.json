		"list.activeSelectionForeground": "#e6e8de",
		"list.inactiveSelectionBackground": "#2f322c",
		"list.inactiveSelectionForeground": "#d2d5ca",
		"list.hoverBackground": "#2f322c",
		"list.focusOutline": "#3dff7a",
		"list.highlightForeground": "#3dff7a",
		"list.errorForeground": "#ff96b8",
		"list.warningForeground": "#ffcf73",
		"input.background": "#2f322c",
		"input.foreground": "#d2d5ca",
		"input.border": "#3d413a",
		"input.placeholderForeground": "#9ba08f",
		"inputOption.activeBorder": "#3dff7a",
		"dropdown.background": "#2f322c",
		"dropdown.foreground": "#d2d5ca",
		"dropdown.border": "#3d413a",
