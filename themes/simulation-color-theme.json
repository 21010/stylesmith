	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#a6aa97",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#4dff86"
			}
		},
		{
			"scope": [
				"keyword.control.flow",
				"keyword.control.trycatch"
			],
			"settings": {
				"foreground": "#ff8c7a"
			}
		},
		{
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#4dff86"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#acb09f"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#e2e5d8"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#b4be8d"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#8ccbff"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#c6cead"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#d2d5ca"
			}
		},
		{
			"scope": [
				"variable.language"
			],
			"settings": {
				"foreground": "#4dff86"
			}
		},
		{
			"scope": [
				"entity.name.namespace",
				"entity.name.module",
				"entity.name.package"
			],
			"settings": {
				"foreground": "#c6cead"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
