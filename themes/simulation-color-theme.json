				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#b4be8d"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#3dff7a"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#ff85a2"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff96b8"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#e2e5d8",
		"method": "#e2e5d8",
		"class": "#c6cead",
		"interface": "#c6cead",
		"type": "#c6cead",
		"enumMember": "#8ccbff",
		"property": "#c6c7bf",
		"parameter": {
			"foreground": "#d2d5ca",
			"italic": true
		},
		"variable.readonly": "#8ccbff",
		"keyword": "#4dff86",
		"string": "#b4be8d",
		"number": "#8ccbff",
		"regexp": "#d4c684",
		"namespace": "#c6cead",
		"enum": "#c6cead",
		"struct": "#c6cead",
		"typeParameter": "#c6cead",
		"decorator": "#e2e5d8",
		"macro": "#e2e5d8",
		"selfKeyword": "#4dff86",
		"*.deprecated": {
			"strikethrough": true
		}
	}
}
