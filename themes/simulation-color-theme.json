		"gitDecoration.modifiedResourceForeground": "#ffb03f",
		"gitDecoration.deletedResourceForeground": "#ff85a2",
		"gitDecoration.untrackedResourceForeground": "#6dff9a",
		"gitDecoration.ignoredResourceForeground": "#9ba08f",
		"gitDecoration.conflictingResourceForeground": "#ffcf73",
		"terminal.background": "#1d1f1b",
		"terminal.foreground": "#d2d5ca",
		"terminalCursor.foreground": "#3dff7a",
		"terminal.selectionBackground": "#4a5a4480",
		"terminal.ansiBlack": "#3d413a",
		"terminal.ansiRed": "#ff6b6b",
		"terminal.ansiGreen": "#5cff8f",
		"terminal.ansiYellow": "#ffcf73",
		"terminal.ansiBlue": "#7cc4ff",
		"terminal.ansiMagenta": "#d7a6ff",
		"terminal.ansiCyan": "#7fe3d6",
		"terminal.ansiWhite": "#d2d5ca",
		"terminal.ansiBrightBlack": "#a6aa97",
		"terminal.ansiBrightRed": "#ff9a94",
		"terminal.ansiBrightGreen": "#a3ffbf",
		"terminal.ansiBrightYellow": "#ffe0a3",
		"terminal.ansiBrightBlue": "#a8d8ff",
		"terminal.ansiBrightMagenta": "#e4c4ff",
		"terminal.ansiBrightCyan": "#b4efe2",
		"terminal.ansiBrightWhite": "#e6e8de"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#a6aa97",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": {
				"foreground": "#4dff86"
			}
		},
		{
			"scope": ["keyword.control.flow", "keyword.control.trycatch"],
			"settings": {
				"foreground": "#ff8c7a"
			}
		},
		{
			"scope": ["keyword.control"],
			"settings": {
				"foreground": "#4dff86"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#acb09f"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#e2e5d8"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#b4bd92"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#8ccbff"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#c2cba4"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#d2d5ca"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#c9ccbe"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#d2d5ca",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#d4c684"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#4dff86"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#b4bd92"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#4dff86",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#b4bd92"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#3dff7a"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff85a2"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff96b8"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#e2e5d8",
		"method": "#e2e5d8",
		"class": "#c2cba4",
		"interface": "#c2cba4",
		"type": "#c2cba4",
		"enumMember": "#8ccbff",
		"property": "#c9ccbe",
		"parameter": {
			"foreground": "#d2d5ca",
			"italic": true
		},
		"variable.readonly": "#8ccbff",
		"keyword": "#4dff86",
		"string": "#b4bd92",
		"number": "#8ccbff",
		"regexp": "#d4c684"
	}
}
