		"sideBarSectionHeader.foreground": "#e6e8de",
		"sideBarSectionHeader.border": "#3d413a",
		"panel.background": "#1d1f1b",
		"panel.border": "#3d413a",
		"panelTitle.activeForeground": "#e6e8de",
		"panelTitle.inactiveForeground": "#a7ab9c",
		"panelTitle.activeBorder": "#3dff7a",
		"statusBar.background": "#1d1f1b",
		"statusBar.foreground": "#d2d5ca",
		"statusBar.border": "#3d413a",
		"statusBar.debuggingBackground": "#7cc4ff",
		"statusBar.debuggingForeground": "#1d1f1b",
		"statusBar.noFolderBackground": "#1d1f1b",
