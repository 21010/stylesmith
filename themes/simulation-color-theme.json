		"button.secondaryBackground": "#2f322c",
		"button.secondaryForeground": "#d2d5ca",
		"badge.background": "#7cc4ff",
		"badge.foreground": "#1d1f1b",
		"progressBar.background": "#3dff7a",
		"quickInput.background": "#2f322c",
		"quickInput.foreground": "#d2d5ca",
		"menu.background": "#2f322c",
		"menu.foreground": "#d2d5ca",
		"menu.selectionBackground": "#30332d",
		"menu.selectionForeground": "#e6e8de",
		"notifications.background": "#2f322c",
		"notifications.foreground": "#d2d5ca",
		"notifications.border": "#3d413a",
