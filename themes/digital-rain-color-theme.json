		"titleBar.activeBackground": "#070c08",
		"titleBar.activeForeground": "#b5f2c0",
		"titleBar.inactiveBackground": "#070c08",
		"titleBar.inactiveForeground": "#86bc91",
		"titleBar.border": "#1b2b1f",
		"activityBar.background": "#070c08",
		"activityBar.foreground": "#d2f9d8",
		"activityBar.inactiveForeground": "#86bc91",
		"activityBar.activeBorder": "#3dff7a",
		"activityBar.border": "#1b2b1f",
		"activityBarBadge.background": "#7dd3ff",
		"activityBarBadge.foreground": "#070c08",
		"sideBar.background": "#070c08",
		"sideBar.foreground": "#b5f2c0",
		"sideBar.border": "#1b2b1f",
