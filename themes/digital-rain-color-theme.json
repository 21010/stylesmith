		"sideBarSectionHeader.background": "#070c08",
		"sideBarSectionHeader.foreground": "#d2f9d8",
		"sideBarSectionHeader.border": "#1b2b1f",
		"panel.background": "#070c08",
		"panel.border": "#1b2b1f",
		"panelTitle.activeForeground": "#d2f9d8",
		"panelTitle.inactiveForeground": "#86bc91",
		"panelTitle.activeBorder": "#3dff7a",
		"statusBar.background": "#070c08",
		"statusBar.foreground": "#b5f2c0",
		"statusBar.border": "#1b2b1f",
		"statusBar.debuggingBackground": "#7dd3ff",
		"statusBar.debuggingForeground": "#070c08",
		"statusBar.noFolderBackground": "#070c08",
		"statusBarItem.remoteBackground": "#3dff7a",
		"statusBarItem.remoteForeground": "#070c08",
		"breadcrumb.foreground": "#86bc91",
		"breadcrumb.focusForeground": "#d2f9d8",
		"breadcrumb.activeSelectionForeground": "#3dff7a",
		"list.activeSelectionBackground": "#101a13",
		"list.activeSelectionForeground": "#d2f9d8",
		"list.inactiveSelectionBackground": "#0f1812",
		"list.inactiveSelectionForeground": "#b5f2c0",
		"list.hoverBackground": "#0f1812",
		"list.focusOutline": "#3dff7a",
		"list.highlightForeground": "#3dff7a",
		"list.errorForeground": "#ff7a6b",
		"list.warningForeground": "#ffcf73",
		"input.background": "#0f1812",
		"input.foreground": "#b5f2c0",
		"input.border": "#1b2b1f",
		"input.placeholderForeground": "#66a372",
		"inputOption.activeBorder": "#3dff7a",
		"dropdown.background": "#0f1812",
		"dropdown.foreground": "#b5f2c0",
		"dropdown.border": "#1b2b1f",
		"button.background": "#3dff7a",
		"button.foreground": "#070c08",
		"button.hoverBackground": "#7dd3ff",
		"button.secondaryBackground": "#0f1812",
		"button.secondaryForeground": "#b5f2c0",
		"badge.background": "#7dd3ff",
		"badge.foreground": "#070c08",
		"progressBar.background": "#3dff7a",
		"quickInput.background": "#0f1812",
		"quickInput.foreground": "#b5f2c0",
		"menu.background": "#0f1812",
		"menu.foreground": "#b5f2c0",
		"menu.selectionBackground": "#101a13",
		"menu.selectionForeground": "#d2f9d8",
		"notifications.background": "#0f1812",
		"notifications.foreground": "#b5f2c0",
		"notifications.border": "#1b2b1f",
		"gitDecoration.addedResourceForeground": "#6dff9a",
		"gitDecoration.modifiedResourceForeground": "#ffb03f",
		"gitDecoration.deletedResourceForeground": "#ff6b6b",
		"gitDecoration.untrackedResourceForeground": "#6dff9a",
		"gitDecoration.ignoredResourceForeground": "#66a372",
		"gitDecoration.conflictingResourceForeground": "#ffcf73",
		"terminal.background": "#070c08",
		"terminal.foreground": "#b5f2c0",
		"terminalCursor.foreground": "#3dff7a",
		"terminal.selectionBackground": "#1f5a3080",
		"terminal.ansiBlack": "#1b2b1f",
		"terminal.ansiRed": "#ff7a6b",
		"terminal.ansiGreen": "#6dff9a",
		"terminal.ansiYellow": "#ffcf73",
		"terminal.ansiBlue": "#7dd3ff",
		"terminal.ansiMagenta": "#d7a6ff",
		"terminal.ansiCyan": "#8fe3d0",
		"terminal.ansiWhite": "#b5f2c0",
		"terminal.ansiBrightBlack": "#66a372",
		"terminal.ansiBrightRed": "#ff9f94",
		"terminal.ansiBrightGreen": "#a3ffbf",
		"terminal.ansiBrightYellow": "#ffe0a3",
		"terminal.ansiBrightBlue": "#a8e2ff",
		"terminal.ansiBrightMagenta": "#e4c4ff",
		"terminal.ansiBrightCyan": "#b4efe2",
		"terminal.ansiBrightWhite": "#d2f9d8"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#66a372",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control"
			],
			"settings": {
				"foreground": "#5dff8f"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#8fcf9c"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#c8ffd3"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#7ed99a"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#7dd3ff"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#a6f5bc"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#b5f2c0"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#a2dfb0"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#b5f2c0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#ff8080"
			}
		},
		{
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#5dff8f"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#9ee8b0"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#5dff8f",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#7ed99a"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#3dff7a"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#ff6b6b"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff7a6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#c8ffd3",
		"method": "#c8ffd3",
		"class": "#a6f5bc",
		"interface": "#a6f5bc",
		"type": "#a6f5bc",
		"enumMember": "#7dd3ff",
		"property": "#a2dfb0",
		"parameter": {
			"foreground": "#b5f2c0",
			"italic": true
		},
		"variable.readonly": "#7dd3ff",
		"keyword": "#5dff8f",
		"string": "#7ed99a",
		"number": "#7dd3ff",
		"regexp": "#ff8080"
	}
}
