		"sideBarSectionHeader.background": "#08070a",
		"sideBarSectionHeader.foreground": "#f7efe6",
		"sideBarSectionHeader.border": "#2a2630",
		"panel.background": "#08070a",
		"panel.border": "#2a2630",
		"panelTitle.activeForeground": "#f7efe6",
		"panelTitle.inactiveForeground": "#b5aaa6",
		"panelTitle.activeBorder": "#ff9a4f",
		"statusBar.background": "#08070a",
		"statusBar.foreground": "#ece2d6",
		"statusBar.border": "#2a2630",
		"statusBar.debuggingBackground": "#c39ff0",
		"statusBar.debuggingForeground": "#08070a",
		"statusBar.noFolderBackground": "#08070a",
		"statusBarItem.remoteBackground": "#ff9a4f",
