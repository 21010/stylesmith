		"gitDecoration.modifiedResourceForeground": "#a9a6f2",
		"gitDecoration.deletedResourceForeground": "#ff8a5c",
		"gitDecoration.untrackedResourceForeground": "#7fd6a3",
		"gitDecoration.ignoredResourceForeground": "#9a9094",
		"gitDecoration.conflictingResourceForeground": "#ffcf73",
		"terminal.background": "#08070a",
		"terminal.foreground": "#ece2d6",
		"terminalCursor.foreground": "#ff9a4f",
		"terminal.selectionBackground": "#4a364a99",
		"terminal.ansiBlack": "#2a2630",
		"terminal.ansiRed": "#f07a72",
		"terminal.ansiGreen": "#8fdca8",
		"terminal.ansiYellow": "#f2c36b",
		"terminal.ansiBlue": "#8fb8de",
		"terminal.ansiMagenta": "#c9a6ec",
		"terminal.ansiCyan": "#7ccfd6",
		"terminal.ansiWhite": "#ece2d6",
		"terminal.ansiBrightBlack": "#9c90a0",
		"terminal.ansiBrightRed": "#f7a7a3",
		"terminal.ansiBrightGreen": "#b6eac6",
		"terminal.ansiBrightYellow": "#f6d696",
		"terminal.ansiBrightBlue": "#b3cfe9",
		"terminal.ansiBrightMagenta": "#dcc2f2",
		"terminal.ansiBrightCyan": "#a2dde2",
		"terminal.ansiBrightWhite": "#f7efe6"
