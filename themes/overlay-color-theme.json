		"panelTitle.activeBorder": "#4fd0e6",
		"statusBar.background": "#11171b",
		"statusBar.foreground": "#d2dce3",
		"statusBar.border": "#2c3942",
		"statusBar.debuggingBackground": "#f5a83a",
		"statusBar.debuggingForeground": "#11171b",
		"statusBar.noFolderBackground": "#11171b",
