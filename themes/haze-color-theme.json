		"panelTitle.activeBorder": "#f09a48",
		"statusBar.background": "#16181a",
		"statusBar.foreground": "#d0d4d6",
		"statusBar.border": "#343a3d",
		"statusBar.debuggingBackground": "#5fc0bb",
		"statusBar.debuggingForeground": "#16181a",
