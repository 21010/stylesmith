	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#9aa0a5",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type", "keyword.control"],
			"settings": {
				"foreground": "#f0a050"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#a5abaf"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#e2e6e8"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#72c6c0"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#f5b878"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#a3d2ce"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#d0d4d6"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#c4c9cc"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#d0d4d6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#9fdad5"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#f0a050"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#72c6c0"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#f0a050",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#72c6c0"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#f09a48"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff6b6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#e2e6e8",
		"method": "#e2e6e8",
		"class": "#a3d2ce",
		"interface": "#a3d2ce",
		"type": "#a3d2ce",
		"enumMember": "#f5b878",
		"property": "#c4c9cc",
		"parameter": {
			"foreground": "#d0d4d6",
			"italic": true
		},
		"variable.readonly": "#f5b878",
		"keyword": "#f0a050",
		"string": "#72c6c0",
		"number": "#f5b878",
		"regexp": "#9fdad5"
	}
}
