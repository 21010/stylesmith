		"titleBar.activeBackground": "#15191e",
		"titleBar.activeForeground": "#cfd6de",
		"titleBar.inactiveBackground": "#15191e",
		"titleBar.inactiveForeground": "#a0aab6",
		"titleBar.border": "#313a45",
		"activityBar.background": "#15191e",
		"activityBar.foreground": "#e4e9ee",
		"activityBar.inactiveForeground": "#a0aab6",
		"activityBar.activeBorder": "#e0874f",
		"activityBar.border": "#313a45",
		"activityBarBadge.background": "#8fb4d9",
		"activityBarBadge.foreground": "#15191e",
		"sideBar.background": "#15191e",
		"sideBar.foreground": "#cfd6de",
		"sideBar.border": "#313a45",
		"sideBarTitle.foreground": "#e4e9ee",
		"sideBarSectionHeader.background": "#15191e",
		"sideBarSectionHeader.foreground": "#e4e9ee",
		"sideBarSectionHeader.border": "#313a45",
		"panel.background": "#15191e",
		"panel.border": "#313a45",
		"panelTitle.activeForeground": "#e4e9ee",
		"panelTitle.inactiveForeground": "#a0aab6",
		"panelTitle.activeBorder": "#e0874f",
		"statusBar.background": "#15191e",
		"statusBar.foreground": "#cfd6de",
		"statusBar.border": "#313a45",
		"statusBar.debuggingBackground": "#8fb4d9",
		"statusBar.debuggingForeground": "#15191e",
		"statusBar.noFolderBackground": "#15191e",
		"statusBarItem.remoteBackground": "#e0874f",
		"statusBarItem.remoteForeground": "#15191e",
		"breadcrumb.foreground": "#a0aab6",
		"breadcrumb.focusForeground": "#e4e9ee",
		"breadcrumb.activeSelectionForeground": "#e0874f",
		"list.activeSelectionBackground": "#232a32",
		"list.activeSelectionForeground": "#e4e9ee",
		"list.inactiveSelectionBackground": "#222830",
		"list.inactiveSelectionForeground": "#cfd6de",
		"list.hoverBackground": "#222830",
		"list.focusOutline": "#e0874f",
		"list.highlightForeground": "#e0874f",
		"list.errorForeground": "#ff7a7a",
		"list.warningForeground": "#f2c36b",
		"input.background": "#222830",
		"input.foreground": "#cfd6de",
		"input.border": "#313a45",
		"input.placeholderForeground": "#8f9aa7",
		"inputOption.activeBorder": "#e0874f",
		"dropdown.background": "#222830",
		"dropdown.foreground": "#cfd6de",
		"dropdown.border": "#313a45",
		"button.background": "#e0874f",
		"button.foreground": "#15191e",
		"button.hoverBackground": "#8fb4d9",
		"button.secondaryBackground": "#222830",
		"button.secondaryForeground": "#cfd6de",
		"badge.background": "#8fb4d9",
		"badge.foreground": "#15191e",
		"progressBar.background": "#e0874f",
		"quickInput.background": "#222830",
		"quickInput.foreground": "#cfd6de",
		"menu.background": "#222830",
		"menu.foreground": "#cfd6de",
		"menu.selectionBackground": "#232a32",
		"menu.selectionForeground": "#e4e9ee",
		"notifications.background": "#222830",
		"notifications.foreground": "#cfd6de",
		"notifications.border": "#313a45",
		"gitDecoration.addedResourceForeground": "#7fd6a3",
		"gitDecoration.modifiedResourceForeground": "#a9a6f2",
		"gitDecoration.deletedResourceForeground": "#ff8a5c",
		"gitDecoration.untrackedResourceForeground": "#7fd6a3",
		"gitDecoration.ignoredResourceForeground": "#8f9aa7",
		"gitDecoration.conflictingResourceForeground": "#f2c36b",
		"terminal.background": "#15191e",
		"terminal.foreground": "#cfd6de",
		"terminalCursor.foreground": "#e0874f",
		"terminal.selectionBackground": "#3d4c6080",
		"terminal.ansiBlack": "#313a45",
		"terminal.ansiRed": "#f07a72",
		"terminal.ansiGreen": "#9ae0b0",
		"terminal.ansiYellow": "#f2c36b",
		"terminal.ansiBlue": "#8fb8de",
		"terminal.ansiMagenta": "#c9a6ec",
		"terminal.ansiCyan": "#7ccfd6",
		"terminal.ansiWhite": "#c5ccd5",
		"terminal.ansiBrightBlack": "#9aa4b0",
		"terminal.ansiBrightRed": "#f7a7a3",
		"terminal.ansiBrightGreen": "#b6eac6",
		"terminal.ansiBrightYellow": "#f6d696",
		"terminal.ansiBrightBlue": "#b3cfe9",
		"terminal.ansiBrightMagenta": "#dcc2f2",
		"terminal.ansiBrightCyan": "#a2dde2",
		"terminal.ansiBrightWhite": "#e4e9ee"
