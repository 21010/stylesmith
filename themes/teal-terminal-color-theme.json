		"gitDecoration.modifiedResourceForeground": "#a9a6f2",
		"gitDecoration.deletedResourceForeground": "#ff8a5c",
		"gitDecoration.untrackedResourceForeground": "#7fd6a3",
		"gitDecoration.ignoredResourceForeground": "#74a398",
		"gitDecoration.conflictingResourceForeground": "#ffcf73",
		"terminal.background": "#0b1817",
		"terminal.foreground": "#bfe8dd",
		"terminalCursor.foreground": "#5fe0c0",
		"terminal.selectionBackground": "#245a5080",
		"terminal.ansiBlack": "#24403d",
		"terminal.ansiRed": "#f07a72",
		"terminal.ansiGreen": "#8fdca8",
		"terminal.ansiYellow": "#f2c36b",
		"terminal.ansiBlue": "#8fb8de",
		"terminal.ansiMagenta": "#c9a6ec",
		"terminal.ansiCyan": "#7ccfd6",
		"terminal.ansiWhite": "#bfe8dd",
		"terminal.ansiBrightBlack": "#7fa89e",
		"terminal.ansiBrightRed": "#f7a7a3",
		"terminal.ansiBrightGreen": "#b6eac6",
		"terminal.ansiBrightYellow": "#f6d696",
		"terminal.ansiBrightBlue": "#b3cfe9",
		"terminal.ansiBrightMagenta": "#dcc2f2",
		"terminal.ansiBrightCyan": "#a2dde2",
		"terminal.ansiBrightWhite": "#dbf5ee"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#7fa89e"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type", "keyword.control"],
			"settings": {
				"foreground": "#5fe0c0"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#92bab0"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#d6f2ea"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#a8d8c8"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#e8d27a"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#8fd8c6"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#bfe8dd"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#b2dcd2"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#bfe8dd"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#c8e0a0"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#5fe0c0"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#a8d8c8"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#5fe0c0"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#dbf5ee"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#a8d8c8"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#5fe0c0"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff6b6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#d6f2ea",
		"method": "#d6f2ea",
		"class": "#8fd8c6",
		"interface": "#8fd8c6",
		"type": "#8fd8c6",
		"enumMember": "#e8d27a",
		"property": "#b2dcd2",
		"parameter": "#bfe8dd",
		"variable.readonly": "#e8d27a",
		"keyword": "#5fe0c0",
		"string": "#a8d8c8",
		"number": "#e8d27a",
		"regexp": "#c8e0a0"
	}
}
