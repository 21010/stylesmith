		"progressBar.background": "#5fe0c0",
		"quickInput.background": "#142725",
		"quickInput.foreground": "#bfe8dd",
		"menu.background": "#142725",
		"menu.foreground": "#bfe8dd",
		"menu.selectionBackground": "#162a28",
		"menu.selectionForeground": "#dbf5ee",
		"notifications.background": "#142725",
		"notifications.foreground": "#bfe8dd",
		"notifications.border": "#24403d",
