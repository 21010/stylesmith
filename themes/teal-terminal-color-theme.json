		"sideBarSectionHeader.border": "#24403d",
		"panel.background": "#0b1817",
		"panel.border": "#24403d",
		"panelTitle.activeForeground": "#dbf5ee",
		"panelTitle.inactiveForeground": "#8fbdb2",
		"panelTitle.activeBorder": "#5fe0c0",
		"statusBar.background": "#0b1817",
		"statusBar.foreground": "#bfe8dd",
		"statusBar.border": "#24403d",
		"statusBar.debuggingBackground": "#e8d27a",
		"statusBar.debuggingForeground": "#0b1817",
		"statusBar.noFolderBackground": "#0b1817",
		"statusBarItem.remoteBackground": "#5fe0c0",
		"statusBarItem.remoteForeground": "#0b1817",
		"breadcrumb.foreground": "#8fbdb2",
