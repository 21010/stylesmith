		"gitDecoration.modifiedResourceForeground": "#b59cff",
		"gitDecoration.deletedResourceForeground": "#ff8a7a",
		"gitDecoration.untrackedResourceForeground": "#6fe0a8",
		"gitDecoration.ignoredResourceForeground": "#8f9ab4",
		"gitDecoration.conflictingResourceForeground": "#ffc857",
		"terminal.background": "#0b1428",
		"terminal.foreground": "#efe8d6",
		"terminalCursor.foreground": "#ffd23f",
		"terminal.selectionBackground": "#2f4a8080",
		"terminal.ansiBlack": "#24345a",
		"terminal.ansiRed": "#ff7b7b",
		"terminal.ansiGreen": "#8fe3a8",
		"terminal.ansiYellow": "#ffd23f",
		"terminal.ansiBlue": "#8fc1ff",
		"terminal.ansiMagenta": "#d6a6ff",
		"terminal.ansiCyan": "#7fe0e8",
		"terminal.ansiWhite": "#e3dccb",
		"terminal.ansiBrightBlack": "#9aa3bd",
		"terminal.ansiBrightRed": "#ffa3a3",
		"terminal.ansiBrightGreen": "#b3edc4",
		"terminal.ansiBrightYellow": "#ffe27a",
		"terminal.ansiBrightBlue": "#b5d6ff",
		"terminal.ansiBrightMagenta": "#e6c6ff",
		"terminal.ansiBrightCyan": "#a8ecf0",
		"terminal.ansiBrightWhite": "#f8f2e4"
