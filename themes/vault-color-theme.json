	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#9aa3bd",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type", "keyword.control"],
			"settings": {
				"foreground": "#ffd23f",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#c6cbd8"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#f8f2e4"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#a8e6a3"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#ffb36b"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#8fc1ff"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#efe8d6"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#e3dccb"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#efe8d6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#a8e6a3"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#ffd23f"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#8fc1ff"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#ffd23f",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#a8e6a3"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#ffd23f"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#6fe0a8"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a7a"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff7b7b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#f8f2e4",
		"method": "#f8f2e4",
		"class": "#8fc1ff",
		"interface": "#8fc1ff",
		"type": "#8fc1ff",
		"enumMember": "#ffb36b",
		"property": "#e3dccb",
		"parameter": {
			"foreground": "#efe8d6",
			"italic": true
		},
		"variable.readonly": "#ffb36b",
		"keyword": {
			"foreground": "#ffd23f",
			"bold": true
		},
		"string": "#a8e6a3",
		"number": "#ffb36b",
		"regexp": "#a8e6a3"
	}
}
