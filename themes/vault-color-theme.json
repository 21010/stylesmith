		"input.foreground": "#efe8d6",
		"input.border": "#24345a",
		"input.placeholderForeground": "#8f9ab4",
		"inputOption.activeBorder": "#ffd23f",
		"dropdown.background": "#15213d",
		"dropdown.foreground": "#efe8d6",
