			],
			"settings": {
				"foreground": "#ff8a7a"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff7b7b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#f8f2e4",
		"method": "#f8f2e4",
		"class": "#8fc1ff",
		"interface": "#8fc1ff",
		"type": "#8fc1ff",
		"enumMember": "#ffb36b",
		"property": "#e7dcbf",
		"parameter": {
			"foreground": "#efe8d6",
			"italic": true
		},
		"variable.readonly": "#ffb36b",
		"keyword": {
			"foreground": "#ffd23f",
			"bold": true
		},
		"string": "#a8e6a3",
		"number": "#ffb36b",
		"regexp": "#a8e6a3",
		"namespace": "#8fc1ff",
		"enum": "#8fc1ff",
		"struct": "#8fc1ff",
		"typeParameter": "#8fc1ff",
		"decorator": "#f8f2e4",
		"macro": "#f8f2e4",
		"selfKeyword": "#ffd23f",
		"*.deprecated": {
			"strikethrough": true
		}
	}
}
