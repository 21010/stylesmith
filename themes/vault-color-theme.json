		"sideBarSectionHeader.background": "#0b1428",
		"sideBarSectionHeader.foreground": "#f8f2e4",
		"sideBarSectionHeader.border": "#24345a",
		"panel.background": "#0b1428",
		"panel.border": "#24345a",
		"panelTitle.activeForeground": "#f8f2e4",
		"panelTitle.inactiveForeground": "#b3b9c9",
		"panelTitle.activeBorder": "#ffd23f",
		"statusBar.background": "#0b1428",
		"statusBar.foreground": "#efe8d6",
		"statusBar.border": "#24345a",
		"statusBar.debuggingBackground": "#8fc1ff",
		"statusBar.debuggingForeground": "#0b1428",
