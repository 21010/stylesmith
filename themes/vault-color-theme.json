		"list.inactiveSelectionForeground": "#efe8d6",
		"list.hoverBackground": "#15213d",
		"list.focusOutline": "#ffd23f",
		"list.highlightForeground": "#ffd23f",
		"list.errorForeground": "#ff7b7b",
