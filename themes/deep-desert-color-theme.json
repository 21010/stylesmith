	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#a59276",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": {
				"foreground": "#f29048"
			}
		},
		{
			"scope": ["keyword.control.flow", "keyword.control.trycatch"],
			"settings": {
				"foreground": "#7ea8f2"
			}
		},
		{
			"scope": ["keyword.control"],
			"settings": {
				"foreground": "#f29048"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#bfa98a"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#f2e2c4"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#d8ab5e"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#f5b07a"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#cfb88a"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#e6d3b0"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#dccbb0"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#e6d3b0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#e8c070"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#f29048"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#d8ab5e"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#f29048",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#d8ab5e"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#f08a3c"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff6b6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#f2e2c4",
		"method": "#f2e2c4",
		"class": "#cfb88a",
		"interface": "#cfb88a",
		"type": "#cfb88a",
		"enumMember": "#f5b07a",
		"property": "#dccbb0",
		"parameter": {
			"foreground": "#e6d3b0",
			"italic": true
		},
		"variable.readonly": "#f5b07a",
		"keyword": "#f29048",
		"string": "#d8ab5e",
		"number": "#f5b07a",
		"regexp": "#e8c070"
	}
}
