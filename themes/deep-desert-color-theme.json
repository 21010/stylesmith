				"markup.list.numbered.bullet"
			],
			"settings": {
				"foreground": "#f29048"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#d8ab5e"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#f08a3c"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff6b6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#f2e2c4",
		"method": "#f2e2c4",
		"class": "#cfb88a",
		"interface": "#cfb88a",
		"type": "#cfb88a",
		"enumMember": "#f5b07a",
		"property": "#d6ccbc",
		"parameter": {
			"foreground": "#e6d3b0",
			"italic": true
		},
		"variable.readonly": "#f5b07a",
		"keyword": "#f29048",
		"string": "#d8ab5e",
		"number": "#f5b07a",
		"regexp": "#e8c070",
		"namespace": "#cfb88a",
		"enum": "#cfb88a",
		"struct": "#cfb88a",
		"typeParameter": "#cfb88a",
		"decorator": "#f2e2c4",
		"macro": "#f2e2c4",
		"selfKeyword": "#f29048",
		"*.deprecated": {
			"strikethrough": true
		}
	}
}
