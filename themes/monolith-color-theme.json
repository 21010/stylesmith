		"gitDecoration.deletedResourceForeground": "#f08a7e",
		"gitDecoration.untrackedResourceForeground": "#7fd4a6",
		"gitDecoration.ignoredResourceForeground": "#858e9b",
		"gitDecoration.conflictingResourceForeground": "#e6c274",
