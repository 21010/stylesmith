	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#9ba3ae",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type", "keyword.control"],
			"settings": {
				"foreground": "#8ab2ff"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#a9b1bc"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#e4e9ef"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#b9c8a8"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#d6b48f"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#a9c4e8"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#d5dae1"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#c8cfd8"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#d5dae1",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#b9c8a8"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#8ab2ff"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#a9c4e8"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#8ab2ff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#b9c8a8"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#7aa7ff"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd4a6"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#f08a7e"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#f2848a"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#e4e9ef",
		"method": "#e4e9ef",
		"class": "#a9c4e8",
		"interface": "#a9c4e8",
		"type": "#a9c4e8",
		"enumMember": "#d6b48f",
		"property": "#c8cfd8",
		"parameter": {
			"foreground": "#d5dae1",
			"italic": true
		},
		"variable.readonly": "#d6b48f",
		"keyword": "#8ab2ff",
		"string": "#b9c8a8",
		"number": "#d6b48f",
		"regexp": "#b9c8a8"
	}
}
