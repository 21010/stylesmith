		"terminal.foreground": "#d5dae1",
		"terminalCursor.foreground": "#7aa7ff",
		"terminal.selectionBackground": "#37486a80",
		"terminal.ansiBlack": "#2d323a",
		"terminal.ansiRed": "#f07880",
		"terminal.ansiGreen": "#a3e8bd",
		"terminal.ansiYellow": "#e6c274",
		"terminal.ansiBlue": "#8ab2ff",
		"terminal.ansiMagenta": "#c9a6ec",
		"terminal.ansiCyan": "#7ccfd6",
		"terminal.ansiWhite": "#c5ccd5",
		"terminal.ansiBrightBlack": "#9ba3ae",
		"terminal.ansiBrightRed": "#f7a7ab",
		"terminal.ansiBrightGreen": "#abe2c2",
		"terminal.ansiBrightYellow": "#efd59a",
		"terminal.ansiBrightBlue": "#adc8ff",
