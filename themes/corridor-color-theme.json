	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#50645f"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type", "keyword.control"],
			"settings": {
				"foreground": "#0a6656"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#2e4a48"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#17496a"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#5c5818"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#8a3426"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#2c5a78"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#123e3d"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#244a52"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#123e3d"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#6a3a6a"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#0a6656"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#5c5818"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#0a6656"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#082928"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#5c5818"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#0b6b5c"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#006b5a"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#b33d00"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#b8203a"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#17496a",
		"method": "#17496a",
		"class": "#2c5a78",
		"interface": "#2c5a78",
		"type": "#2c5a78",
		"enumMember": "#8a3426",
		"property": "#244a52",
		"parameter": "#123e3d",
		"variable.readonly": "#8a3426",
		"keyword": "#0a6656",
		"string": "#5c5818",
		"number": "#8a3426",
		"regexp": "#6a3a6a"
	}
}
