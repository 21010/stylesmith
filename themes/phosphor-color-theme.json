		"tab.hoverBackground": "#122018",
		"titleBar.activeBackground": "#070e09",
		"titleBar.activeForeground": "#b9f2b4",
		"titleBar.inactiveBackground": "#070e09",
		"titleBar.inactiveForeground": "#8cc294",
		"titleBar.border": "#1f3826",
		"activityBar.background": "#070e09",
		"activityBar.foreground": "#d6f7d2",
		"activityBar.inactiveForeground": "#8cc294",
		"activityBar.activeBorder": "#4dff88",
		"activityBar.border": "#1f3826",
		"activityBarBadge.background": "#d8ff8a",
		"activityBarBadge.foreground": "#07100a",
		"sideBar.background": "#070e09",
		"sideBar.foreground": "#b9f2b4",
		"sideBar.border": "#1f3826",
		"sideBarTitle.foreground": "#d6f7d2",
		"sideBarSectionHeader.background": "#070e09",
		"sideBarSectionHeader.foreground": "#d6f7d2",
		"sideBarSectionHeader.border": "#1f3826",
		"panel.background": "#070e09",
		"panel.border": "#1f3826",
		"panelTitle.activeForeground": "#d6f7d2",
		"panelTitle.inactiveForeground": "#8cc294",
		"panelTitle.activeBorder": "#4dff88",
		"statusBar.background": "#070e09",
		"statusBar.foreground": "#b9f2b4",
		"statusBar.border": "#1f3826",
		"statusBar.debuggingBackground": "#d8ff8a",
		"statusBar.debuggingForeground": "#07100a",
		"statusBar.noFolderBackground": "#070e09",
		"statusBarItem.remoteBackground": "#4dff88",
		"statusBarItem.remoteForeground": "#07100a",
		"breadcrumb.foreground": "#8cc294",
		"breadcrumb.focusForeground": "#d6f7d2",
		"breadcrumb.activeSelectionForeground": "#4dff88",
		"list.activeSelectionBackground": "#132117",
		"list.activeSelectionForeground": "#d6f7d2",
		"list.inactiveSelectionBackground": "#122018",
		"list.inactiveSelectionForeground": "#b9f2b4",
		"list.hoverBackground": "#122018",
		"list.focusOutline": "#4dff88",
		"list.highlightForeground": "#4dff88",
		"list.errorForeground": "#ff7a6b",
		"list.warningForeground": "#ffcf73",
		"input.background": "#122018",
		"input.foreground": "#b9f2b4",
		"input.border": "#1f3826",
		"input.placeholderForeground": "#6b9e73",
		"inputOption.activeBorder": "#4dff88",
		"dropdown.background": "#122018",
		"dropdown.foreground": "#b9f2b4",
		"dropdown.border": "#1f3826",
		"button.background": "#4dff88",
		"button.foreground": "#07100a",
		"button.hoverBackground": "#d8ff8a",
		"button.secondaryBackground": "#122018",
		"button.secondaryForeground": "#b9f2b4",
		"badge.background": "#d8ff8a",
		"badge.foreground": "#07100a",
		"progressBar.background": "#4dff88",
		"quickInput.background": "#122018",
		"quickInput.foreground": "#b9f2b4",
		"menu.background": "#122018",
		"menu.foreground": "#b9f2b4",
		"menu.selectionBackground": "#132117",
		"menu.selectionForeground": "#d6f7d2",
		"notifications.background": "#122018",
		"notifications.foreground": "#b9f2b4",
		"notifications.border": "#1f3826",
		"gitDecoration.addedResourceForeground": "#6dff9a",
		"gitDecoration.modifiedResourceForeground": "#ffb03f",
		"gitDecoration.deletedResourceForeground": "#ff6b6b",
		"gitDecoration.untrackedResourceForeground": "#6dff9a",
		"gitDecoration.ignoredResourceForeground": "#6b9e73",
		"gitDecoration.conflictingResourceForeground": "#ffcf73",
		"terminal.background": "#070e09",
		"terminal.foreground": "#b9f2b4",
		"terminalCursor.foreground": "#4dff88",
		"terminal.selectionBackground": "#2e6b3f80",
		"terminal.ansiBlack": "#1f3826",
		"terminal.ansiRed": "#ff7a6b",
		"terminal.ansiGreen": "#6dff9a",
		"terminal.ansiYellow": "#ffcf73",
		"terminal.ansiBlue": "#7fc8ff",
		"terminal.ansiMagenta": "#d7a6ff",
		"terminal.ansiCyan": "#8fe3d0",
		"terminal.ansiWhite": "#b9f2b4",
		"terminal.ansiBrightBlack": "#6fa878",
		"terminal.ansiBrightRed": "#ff9d92",
		"terminal.ansiBrightGreen": "#9dffbc",
		"terminal.ansiBrightYellow": "#ffdf9e",
		"terminal.ansiBrightBlue": "#a8daff",
		"terminal.ansiBrightMagenta": "#e4c4ff",
		"terminal.ansiBrightCyan": "#b5ede0",
		"terminal.ansiBrightWhite": "#d6f7d2"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6fa878"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control"
			],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#a3dfa9"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#ccf7c0"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#9bdcb0"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#d8ff8a"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#a6ffd0"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#b9f2b4"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#c8f0a0"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#b9f2b4"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#d8ff8a"
			}
		},
		{
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#9bdcb0"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#d6f7d2"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#9bdcb0"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#4dff88"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#ff6b6b"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff7a6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#ccf7c0",
		"method": "#ccf7c0",
		"class": "#a6ffd0",
		"interface": "#a6ffd0",
		"type": "#a6ffd0",
		"enumMember": "#d8ff8a",
		"property": "#c8f0a0",
		"parameter": "#b9f2b4",
		"variable.readonly": "#d8ff8a",
		"keyword": "#6dff9a",
		"string": "#9bdcb0",
		"number": "#d8ff8a",
		"regexp": "#d8ff8a"
	}
}
