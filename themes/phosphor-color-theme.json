	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6fa878"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control"
			],
			"settings": {
				"foreground": "#6dff9a"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#a3dfa9"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#ccf7c0"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#9bdcb0"
