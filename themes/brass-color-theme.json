	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#ad9d82",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type", "keyword.control"],
			"settings": {
				"foreground": "#e0aa48"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#c9b896"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#ec9a6a"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#86c9aa"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#f2a878"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#a8d8c2"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#e8dcc4"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#dccdb0"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#e8dcc4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#e8c060"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#e0aa48"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#86c9aa"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#e0aa48",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#86c9aa"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#d9a441"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff6b6b"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#ec9a6a",
		"method": "#ec9a6a",
		"class": "#a8d8c2",
		"interface": "#a8d8c2",
		"type": "#a8d8c2",
		"enumMember": "#f2a878",
		"property": "#dccdb0",
		"parameter": {
			"foreground": "#e8dcc4",
			"italic": true
		},
		"variable.readonly": "#f2a878",
		"keyword": "#e0aa48",
		"string": "#86c9aa",
		"number": "#f2a878",
		"regexp": "#e8c060"
	}
}
