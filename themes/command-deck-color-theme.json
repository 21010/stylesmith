		"tab.hoverBackground": "#1a1b1e",
		"titleBar.activeBackground": "#0f1012",
		"titleBar.activeForeground": "#c9cdd2",
		"titleBar.inactiveBackground": "#0f1012",
		"titleBar.inactiveForeground": "#9a9fa6",
		"titleBar.border": "#2e3135",
		"activityBar.background": "#0f1012",
