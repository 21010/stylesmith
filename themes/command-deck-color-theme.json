		"sideBarSectionHeader.border": "#2e3135",
		"panel.background": "#0f1012",
		"panel.border": "#2e3135",
		"panelTitle.activeForeground": "#e2e5e9",
		"panelTitle.inactiveForeground": "#9a9fa6",
		"panelTitle.activeBorder": "#ff5c5c",
		"statusBar.background": "#0f1012",
		"statusBar.foreground": "#c9cdd2",
		"statusBar.border": "#2e3135",
		"statusBar.debuggingBackground": "#7f9cc0",
		"statusBar.debuggingForeground": "#0f1012",
		"statusBar.noFolderBackground": "#0f1012",
		"statusBarItem.remoteBackground": "#ff5c5c",
		"statusBarItem.remoteForeground": "#0f1012",
		"breadcrumb.foreground": "#9a9fa6",
		"breadcrumb.focusForeground": "#e2e5e9",
		"breadcrumb.activeSelectionForeground": "#ff5c5c",
		"list.activeSelectionBackground": "#1c1e21",
		"list.activeSelectionForeground": "#e2e5e9",
		"list.inactiveSelectionBackground": "#1a1b1e",
		"list.inactiveSelectionForeground": "#c9cdd2",
		"list.hoverBackground": "#1a1b1e",
		"list.focusOutline": "#ff5c5c",
		"list.highlightForeground": "#ff5c5c",
		"list.errorForeground": "#ff9a94",
		"list.warningForeground": "#ffcf73",
		"input.background": "#1a1b1e",
		"input.foreground": "#c9cdd2",
		"input.border": "#2e3135",
		"input.placeholderForeground": "#83888f",
		"inputOption.activeBorder": "#ff5c5c",
		"dropdown.background": "#1a1b1e",
		"dropdown.foreground": "#c9cdd2",
		"dropdown.border": "#2e3135",
		"button.background": "#ff5c5c",
		"button.foreground": "#0f1012",
