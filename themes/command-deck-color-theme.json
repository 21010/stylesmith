		"button.secondaryBackground": "#1a1b1e",
		"button.secondaryForeground": "#c9cdd2",
		"badge.background": "#7f9cc0",
		"badge.foreground": "#0f1012",
		"progressBar.background": "#ff5c5c",
		"quickInput.background": "#1a1b1e",
		"quickInput.foreground": "#c9cdd2",
		"menu.background": "#1a1b1e",
		"menu.foreground": "#c9cdd2",
		"menu.selectionBackground": "#1c1e21",
		"menu.selectionForeground": "#e2e5e9",
		"notifications.background": "#1a1b1e",
		"notifications.foreground": "#c9cdd2",
		"notifications.border": "#2e3135",
		"gitDecoration.addedResourceForeground": "#7fd6a3",
		"gitDecoration.modifiedResourceForeground": "#a9a6f2",
		"gitDecoration.deletedResourceForeground": "#ff8a5c",
		"gitDecoration.untrackedResourceForeground": "#7fd6a3",
		"gitDecoration.ignoredResourceForeground": "#83888f",
		"gitDecoration.conflictingResourceForeground": "#ffcf73",
		"terminal.background": "#0f1012",
		"terminal.foreground": "#c9cdd2",
		"terminalCursor.foreground": "#ff5c5c",
		"terminal.selectionBackground": "#3a404a99",
		"terminal.ansiBlack": "#2e3135",
		"terminal.ansiRed": "#f07a72",
		"terminal.ansiGreen": "#8fdca8",
		"terminal.ansiYellow": "#f2c36b",
		"terminal.ansiBlue": "#8fb8de",
		"terminal.ansiMagenta": "#c9a6ec",
		"terminal.ansiCyan": "#7ccfd6",
		"terminal.ansiWhite": "#c9cdd2",
		"terminal.ansiBrightBlack": "#8e9299",
		"terminal.ansiBrightRed": "#f7a7a3",
		"terminal.ansiBrightGreen": "#b6eac6",
		"terminal.ansiBrightYellow": "#f6d696",
		"terminal.ansiBrightBlue": "#b3cfe9",
		"terminal.ansiBrightMagenta": "#dcc2f2",
		"terminal.ansiBrightCyan": "#a2dde2",
		"terminal.ansiBrightWhite": "#e2e5e9"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#8e9299",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": {
				"foreground": "#8ea6c6"
			}
		},
		{
			"scope": ["keyword.control.flow", "keyword.control.trycatch"],
			"settings": {
				"foreground": "#ff6b6b"
			}
		},
		{
			"scope": ["keyword.control"],
			"settings": {
				"foreground": "#8ea6c6"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": {
				"foreground": "#9da2a9"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#dfe2e6"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#b4bac2"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#a9c0dc"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#9fb2c8"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": {
				"foreground": "#c9cdd2"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#c0c5cb"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#c9cdd2",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string.regexp", "constant.character.escape"],
			"settings": {
				"foreground": "#c4ccd6"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#8ea6c6"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#b4bac2"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#8ea6c6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#b4bac2"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#ff5c5c"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#7fd6a3"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8a5c"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff9a94"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#dfe2e6",
		"method": "#dfe2e6",
		"class": "#9fb2c8",
		"interface": "#9fb2c8",
		"type": "#9fb2c8",
		"enumMember": "#a9c0dc",
		"property": "#c0c5cb",
		"parameter": {
			"foreground": "#c9cdd2",
			"italic": true
		},
		"variable.readonly": "#a9c0dc",
		"keyword": "#8ea6c6",
		"string": "#b4bac2",
		"number": "#a9c0dc",
		"regexp": "#c4ccd6"
	}
}
