{
	// Type-checks the effect scripts injected into the VS Code workbench page. They're plain
	// JavaScript (they run as they are), so this only checks them; nothing is emitted.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": [],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"skipLibCheck": true
	},
	"include": ["assets/effects/*.js"]
}
