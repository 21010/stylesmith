{
	"name": "stylesmith",
	"displayName": "Stylesmith",
	"description": "Inject your own CSS and JavaScript into the VS Code workbench. A modern TypeScript fork of Custom CSS and JS Loader.",
	"version": "1.0.0",
	"publisher": "21010",
	"author": {
		"name": "Grzegorz Ziolo",
		"url": "https://github.com/21010"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.93.0"
	},
	"categories": [
		"Themes",
		"Other"
	],
	"keywords": [
		"css",
		"javascript",
		"custom css",
		"theme",
		"workbench",
		"customization"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/21010/stylesmith"
	},
	"bugs": {
		"url": "https://github.com/21010/stylesmith/issues"
	},
	"homepage": "https://github.com/21010/stylesmith#readme",
	"preview": true,
	"icon": "images/logo.png",
	"galleryBanner": {
		"color": "#4F46E5",
		"theme": "dark"
	},
	"activationEvents": [],
	"main": "./out/extension.js",
	"extensionKind": [
		"ui"
	],
	"contributes": {
		"commands": [
			{
				"command": "stylesmith.enable",
				"title": "Enable",
				"category": "Stylesmith"
			},
			{
				"command": "stylesmith.disable",
				"title": "Disable",
				"category": "Stylesmith"
			},
			{
				"command": "stylesmith.reload",
				"title": "Reload",
				"category": "Stylesmith"
			}
		],
		"configuration": {
			"title": "Stylesmith",
			"properties": {
				"stylesmith.imports": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "URLs of `.css` and `.js` files to inject, e.g. `file:///C:/Users/me/custom.css` or `https://example.com/theme.css`. File URLs support variables such as `${userHome}`. Run **Stylesmith: Reload** after changing this."
				},
				"stylesmith.statusbar": {
					"type": "boolean",
					"default": true,
					"description": "Show a status bar icon while custom CSS/JS is active."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint .",
		"format": "prettier --write src assets eslint.config.mjs tsconfig.json package.json",
		"format:check": "prettier --check src assets eslint.config.mjs tsconfig.json package.json",
		"pretest": "npm run compile",
		"test": "node --test \"out/test/**/*.test.js\""
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^20.19.43",
		"@types/vscode": "~1.93.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0"
	}
}
