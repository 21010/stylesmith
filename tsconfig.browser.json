{
	// The browser tests (src/test-browser) run code in a web page, so they also need the DOM
	// types. They're kept out of tsconfig.json so the extension itself can't use them.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src/test-browser"],
	"exclude": []
}
